LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local Playwright browser. Install with: uv run playwright install chromium
BROWSER_ENGINE=chromium
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=.browser/profile
BROWSER_ARTIFACT_DIR=.browser/artifacts
BROWSER_UPLOAD_DIR=.browser/uploads
BROWSER_ACTION_TIMEOUT=15
BROWSER_NAVIGATION_TIMEOUT=30
BROWSER_SCRIPT_TIMEOUT=60
