{
  "name": "jarvis-desktop",
  "productName": "Jarvis",
  "version": "0.1.0",
  "description": "Local desktop voice interface for the Jarvis agent",
  "private": true,
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "build": "npm run typecheck && electron-forge package",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "test:core": "tsc -p tsconfig.core-test.json && node --test .test-build/tests/core.test.js",
    "test:e2e": "playwright test",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.2"
  }
}
